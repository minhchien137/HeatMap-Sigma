<script src="~/js/i18n.js"></script>
<script>

    // ── Tab switching (supports users / logs / workconfig) ────────────────
    function switchTab(tab) {
        ['users', 'logs', 'workconfig', 'holiday'].forEach(id => {
            document.getElementById(id + 'Tab')?.classList.remove('active');
            document.getElementById(id + 'Content')?.classList.add('hidden');
        });
        document.getElementById(tab + 'Tab')?.classList.add('active');
        document.getElementById(tab + 'Content')?.classList.remove('hidden');
        if (tab === 'workconfig' && wcState.page === 0) loadWorkConfigs(1);
        if (tab === 'holiday') loadHolidays(hlState.page || 1);
    }

    // ── Reset / Permission modal helpers ─────────────────────────────────
    function openResetModal(svnCode) {
        document.getElementById('resetSVNCode').value = svnCode;
        document.getElementById('displaySVNCode').textContent = svnCode;
        document.getElementById('resetPasswordModal').classList.remove('hidden');
        document.getElementById('resetPasswordModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeResetModal() {
        document.getElementById('resetPasswordModal').classList.add('hidden');
        document.getElementById('resetPasswordModal').style.display = 'none';
        document.getElementById('resetForm').reset();
        document.body.style.overflow = 'auto';
    }

    function openPermissionModal(svnCode, currentPermission) {
        document.getElementById('permissionSVNCode').value = svnCode;
        document.getElementById('displayPermissionSVNCode').textContent = svnCode;
        document.getElementById('permissionSelect').value = currentPermission;
        document.getElementById('permissionModal').classList.remove('hidden');
        document.getElementById('permissionModal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closePermissionModal() {
        document.getElementById('permissionModal').classList.add('hidden');
        document.getElementById('permissionModal').style.display = 'none';
        document.getElementById('permissionForm').reset();
        document.body.style.overflow = 'auto';
    }

    // Close modals when clicking outside
    document.getElementById('resetPasswordModal')?.addEventListener('click', function (e) {
        if (e.target === this) closeResetModal();
    });
    document.getElementById('permissionModal')?.addEventListener('click', function (e) {
        if (e.target === this) closePermissionModal();
    });

    // Close modal on ESC key
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeResetModal();
            closePermissionModal();
            closeWCModal();
            closeWCDeleteModal();
        }
    });

    // Auto switch to logs tab if filter params present
    window.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('svnCodeFilter') || urlParams.has('actionTypeFilter') ||
            urlParams.has('fromDate') || urlParams.has('toDate') || urlParams.has('page')) {
            switchTab('logs');
        }

        // Render last login với i18n
        document.querySelectorAll('[data-lastlogin]').forEach(el => {
            el.textContent = el.dataset.lastlogin || t('admin.not_logged_in');
        });
    });

    // Re-apply last login text khi đổi ngôn ngữ
    document.addEventListener('i18n:applied', function () {
        document.querySelectorAll('[data-lastlogin]').forEach(el => {
            el.textContent = el.dataset.lastlogin || t('admin.not_logged_in');
        });
        // Re-translate status badges và text được render động trong bảng WorkConfig
        document.querySelectorAll('#wcTableBody [data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (typeof t === 'function') el.textContent = t(key) || el.textContent;
        });
    });

    // ═════════════════════════════════════════════════════════════════════
    // WorkConfig
    // ═════════════════════════════════════════════════════════════════════

    // ── State ─────────────────────────────────────────────────────────────
    const wcState    = { page: 0, totalPages: 1, deleteId: null };
    const wcRowCache = {};   // id → row object, dùng cho nút sửa

    // ── Load data ─────────────────────────────────────────────────────────
    async function loadWorkConfigs(page) {
        wcState.page = page;
        const smStaff  = document.getElementById('wcFilterStaff').value.trim();
        const status   = document.getElementById('wcFilterStatus').value;
        const pageSize = document.getElementById('wcPageSize').value;

        const tbody = document.getElementById('wcTableBody');
        tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-12 text-center text-gray-400">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-red-600 mb-2"></div>
            <p>${typeof t === 'function' ? t('common.loading') : 'Đang tải...'}</p></td></tr>`;

        const params = new URLSearchParams({ smStaff, status, page, pageSize });
        const res    = await fetch(`/Admin/GetWorkConfigs?${params}`);
        const json   = await res.json();

        wcState.totalPages = json.totalPages;
        document.getElementById('wcTotalCount').textContent = json.total;

        if (!json.data || json.data.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-12 text-center text-gray-400 text-sm"
                data-i18n="admin.wc.nodata">${typeof t === 'function' ? t('admin.wc.nodata') : 'Không tìm thấy dữ liệu'}</td></tr>`;
            document.getElementById('wcPagination').classList.add('hidden');
            return;
        }

        tbody.innerHTML = json.data.map(row => {
            // Cache row để nút sửa dùng lại — tránh nhúng JSON vào onclick attribute
            wcRowCache[row.id] = row;

            const activeClass  = row.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
            const activeI18nKey = row.isActive ? 'admin.wc.status.active' : 'admin.wc.status.expired';
            const activeText   = typeof t === 'function' ? t(activeI18nKey) : (row.isActive ? 'Còn hiệu lực' : 'Hết hiệu lực');
            const staff        = row.sMStaff || row.smStaff;
            const toText       = row.effectiveTo
                ? new Date(row.effectiveTo).toLocaleDateString('vi-VN')
                : `<span class="text-gray-400 italic" data-i18n="admin.wc.no_limit">${typeof t === 'function' ? t('admin.wc.no_limit') : 'Không giới hạn'}</span>`;

            return `<tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 font-black text-gray-900">${staff}</td>
                <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-black bg-blue-50 text-blue-700">
                        ${row.workHoursPerDay}h
                    </span>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-700">
                    ${new Date(row.effectiveFrom).toLocaleDateString('vi-VN')}
                </td>
                <td class="px-4 py-3 text-center text-sm">${toText}</td>
                <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${activeClass}"
                          data-i18n="${activeI18nKey}">
                        ${activeText}
                    </span>
                </td>
                <td class="px-4 py-3 text-center text-sm text-gray-600">${row.updatedBy || '—'}</td>
                <td class="px-4 py-3 text-center text-xs text-gray-500">
                    ${new Date(row.updatedAt).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                </td>
                <td class="px-4 py-3 text-center">
                    <div class="flex gap-1.5 justify-center">
                        <button onclick="openWCModalById(${row.id})"
                            class="px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg text-xs font-bold hover:bg-blue-100 transition-all">✏️</button>
                        <button onclick="openWCDeleteModal(${row.id},'${staff}')"
                            class="px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-bold hover:bg-red-100 transition-all">🗑️</button>
                    </div>
                </td>
            </tr>`;
        }).join('');

        renderWCPagination(page, json.totalPages);
    }

    function renderWCPagination(page, totalPages) {
        const pag  = document.getElementById('wcPagination');
        const info = document.getElementById('wcPaginationInfo');
        const btns = document.getElementById('wcPaginationBtns');
        if (totalPages <= 1) { pag.classList.add('hidden'); return; }
        pag.classList.remove('hidden');
        info.textContent = `${typeof t === 'function' ? t('admin.log.page') : 'Trang'} ${page} / ${totalPages}`;

        let html = '';
        if (page > 1)
            html += `<button onclick="loadWorkConfigs(${page - 1})"
                class="px-4 py-2 bg-gray-100 text-gray-700 rounded-xl font-bold text-sm hover:bg-gray-200 transition-all">← ${typeof t === 'function' ? t('admin.log.page.prev') : 'Trước'}</button>`;
        const start = Math.max(1, page - 2);
        const end   = Math.min(totalPages, page + 2);
        for (let p = start; p <= end; p++)
            html += `<button onclick="loadWorkConfigs(${p})"
                class="px-4 py-2 ${p === page ? 'bg-red-600 text-white shadow-lg shadow-red-600/20' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'} rounded-xl font-bold text-sm transition-all">${p}</button>`;
        if (page < totalPages)
            html += `<button onclick="loadWorkConfigs(${page + 1})"
                class="px-4 py-2 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 transition-all shadow-lg">${typeof t === 'function' ? t('admin.log.page.next') : 'Sau'} →</button>`;
        btns.innerHTML = html;
    }

    // ── Modal Add/Edit ────────────────────────────────────────────────────
    // Wrapper gọi từ nút sửa — lấy row từ cache thay vì truyền JSON qua onclick
    function openWCModalById(id) {
        openWCModal(wcRowCache[id]);
    }

    function openWCModal(row) {
        const titleEl = document.getElementById('wcModalTitle');
        if (row && row.id) {
            titleEl.textContent = typeof t === 'function' ? t('admin.wc.modal.edit.title') : 'Chỉnh sửa cấu hình';
            document.getElementById('wcEditId').value = row.id;
            document.getElementById('wcStaff').value  = row.sMStaff || row.smStaff || '';
            document.getElementById('wcHours').value  = row.workHoursPerDay;
            document.getElementById('wcFrom').value   = row.effectiveFrom?.substring(0, 10) || '';
            document.getElementById('wcTo').value     = row.effectiveTo?.substring(0, 10) || '';
            document.getElementById('wcStaff').readOnly = true;
            document.getElementById('wcStaff').classList.add('opacity-60');
        } else {
            titleEl.textContent = typeof t === 'function' ? t('admin.wc.modal.add.title') : 'Thêm cấu hình giờ làm';
            document.getElementById('wcEditId').value = '';
            document.getElementById('wcStaff').value  = '';
            document.getElementById('wcHours').value  = '8.5';
            document.getElementById('wcFrom').value   = new Date().toISOString().substring(0, 10);
            document.getElementById('wcTo').value     = '';
            document.getElementById('wcStaff').readOnly = false;
            document.getElementById('wcStaff').classList.remove('opacity-60');
        }
        const modal = document.getElementById('wcModal');
        modal.classList.remove('hidden');
        modal.style.display = 'flex';
    }

    function closeWCModal() {
        const modal = document.getElementById('wcModal');
        modal.classList.add('hidden');
        modal.style.display = 'none';
    }

    async function saveWorkConfig() {
        const id    = document.getElementById('wcEditId').value;
        const staff = document.getElementById('wcStaff').value.trim().toUpperCase();
        const hours = parseFloat(document.getElementById('wcHours').value);
        const from  = document.getElementById('wcFrom').value;
        const to    = document.getElementById('wcTo').value;

        if (!staff || !from || isNaN(hours)) {
            alert('Vui lòng điền đầy đủ thông tin!'); return;
        }

        const body = { id: id ? parseInt(id) : null, SMStaff: staff, WorkHoursPerDay: hours, EffectiveFrom: from, EffectiveTo: to };
        const res  = await fetch('/Admin/SaveWorkConfig', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        const json = await res.json();
        if (json.success) { closeWCModal(); loadWorkConfigs(wcState.page || 1); }
        else alert(json.message || 'Có lỗi xảy ra!');
    }

    // ── Modal Delete ──────────────────────────────────────────────────────
    function openWCDeleteModal(id, staff) {
        wcState.deleteId = id;
        const msg = `${typeof t === 'function' ? t('admin.wc.confirm.del') : 'Bạn có chắc muốn xóa cấu hình của'} [${staff}]?`;
        document.getElementById('wcDeleteMsg').textContent = msg;
        const modal = document.getElementById('wcDeleteModal');
        modal.classList.remove('hidden');
        modal.style.display = 'flex';
    }

    function closeWCDeleteModal() {
        const modal = document.getElementById('wcDeleteModal');
        modal.classList.add('hidden');
        modal.style.display = 'none';
        wcState.deleteId = null;
    }

    async function confirmDeleteWC() {
        if (!wcState.deleteId) return;
        const res  = await fetch('/Admin/DeleteWorkConfig', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(wcState.deleteId)
        });
        const json = await res.json();
        if (json.success) { closeWCDeleteModal(); loadWorkConfigs(wcState.page || 1); }
        else alert(json.message || 'Có lỗi xảy ra!');
    }

    // ── Reset filter ──────────────────────────────────────────────────────
    function resetWCFilter() {
        document.getElementById('wcFilterStaff').value  = '';
        document.getElementById('wcFilterStatus').value = '';
        loadWorkConfigs(1);
    }

    // ── Export ────────────────────────────────────────────────────────────
    function exportWorkConfigs() {
        const smStaff = document.getElementById('wcFilterStaff').value.trim();
        const status  = document.getElementById('wcFilterStatus').value;
        window.location.href = `/Admin/ExportWorkConfigs?smStaff=${encodeURIComponent(smStaff)}&status=${status}`;
    }

    // ── Close WC modals on outside click ─────────────────────────────────
    document.getElementById('wcModal')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeWCModal(); });
    document.getElementById('wcDeleteModal')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeWCDeleteModal(); });

    // ════════════════════════════════════════════════════════════════════════
    // HOLIDAY TAB JS
    // ════════════════════════════════════════════════════════════════════════

    const hlState = { page: 1, deleteId: null };
    const hlRowCache = {};

    // ── Khởi tạo dropdown năm ────────────────────────────────────────────
    (function initHolidayYearFilter() {
        const sel = document.getElementById('hlFilterYear');
        const cur = new Date().getFullYear();
        for (let y = cur + 1; y >= cur - 3; y--) {
            const opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            if (y === cur) opt.selected = true;
            sel.appendChild(opt);
        }
    })();

    // ── Load danh sách ────────────────────────────────────────────────────
    async function loadHolidays(page) {
        hlState.page = page || 1;
        const year    = document.getElementById('hlFilterYear').value;
        const keyword = document.getElementById('hlFilterKeyword').value.trim();
        const size    = parseInt(document.getElementById('hlPageSize').value) || 20;

        const params = new URLSearchParams({ page: hlState.page, pageSize: size });
        if (year)    params.set('year',    year);
        if (keyword) params.set('keyword', keyword);

        document.getElementById('hlTableBody').innerHTML =
            `<tr><td colspan="5" class="px-4 py-10 text-center text-gray-400 text-sm">
                <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-red-600 mr-2"></div>Đang tải...
             </td></tr>`;

        const res  = await fetch('/Admin/GetHolidays?' + params.toString());
        const json = await res.json();

        document.getElementById('hlTotalCount').textContent = json.total;
        renderHolidayTable(json.data);
        renderHolidayPagination(hlState.page, json.totalPages);
    }

    function renderHolidayTable(rows) {
        const tbody = document.getElementById('hlTableBody');
        if (!rows || rows.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-12 text-center text-gray-400 text-sm">${t('admin.hl.nodata') || 'Không có dữ liệu'}</td></tr>`;
            return;
        }
        tbody.innerHTML = rows.map(row => {
            hlRowCache[row.id] = row;
            const d = new Date(row.holidayDate);
            const dateStr = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
            const recurringBadge = row.isRecurring
                ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">${t('admin.hl.recurring.yes') || '🔁 Hàng năm'}</span>`
                : `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-500">${t('admin.hl.recurring.no') || 'Một lần'}</span>`;
            return `<tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 font-bold text-gray-900">${dateStr}</td>
                <td class="px-4 py-3 text-gray-700">${row.name}</td>
                <td class="px-4 py-3 text-center">${recurringBadge}</td>
                <td class="px-4 py-3 text-center text-gray-400 text-xs hidden sm:table-cell">${row.createdAt}</td>
                <td class="px-4 py-3 text-center">
                    <div class="flex gap-1.5 justify-center">
                        <button onclick="openHolidayModalById(${row.id})"
                            class="px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg text-xs font-bold hover:bg-blue-100 transition-all">✏️</button>
                        <button onclick="openHolidayDeleteModal(${row.id},'${row.name.replace(/'/g,"\\'")}')"
                            class="px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-bold hover:bg-red-100 transition-all">🗑️</button>
                    </div>
                </td>
            </tr>`;
        }).join('');
    }

    function renderHolidayPagination(page, totalPages) {
        const pag  = document.getElementById('hlPagination');
        const info = document.getElementById('hlPaginationInfo');
        const btns = document.getElementById('hlPaginationBtns');
        if (totalPages <= 1) { pag.classList.add('hidden'); return; }
        pag.classList.remove('hidden');
        info.textContent = `Trang ${page} / ${totalPages}`;
        let html = '';
        if (page > 1)
            html += `<button onclick="loadHolidays(${page-1})" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-xl font-bold text-sm hover:bg-gray-200">← Trước</button>`;
        const start = Math.max(1, page-2), end = Math.min(totalPages, page+2);
        for (let p = start; p <= end; p++)
            html += `<button onclick="loadHolidays(${p})" class="px-4 py-2 ${p===page?'bg-red-600 text-white shadow-lg shadow-red-600/20':'bg-gray-100 text-gray-700 hover:bg-gray-200'} rounded-xl font-bold text-sm">${p}</button>`;
        if (page < totalPages)
            html += `<button onclick="loadHolidays(${page+1})" class="px-4 py-2 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 shadow-lg">Sau →</button>`;
        btns.innerHTML = html;
    }

    // ── Modal Add/Edit ────────────────────────────────────────────────────
function openHolidayModalById(id) { openHolidayModal(hlRowCache[id]); }

    let hlMode = 'single';

    function setHlMode(mode) {
        hlMode = mode;
        const btnSingle  = document.getElementById('hlModeSingle');
        const btnRange   = document.getElementById('hlModeRange');
        const wrapSingle = document.getElementById('hlSingleDateWrap');
        const wrapRange  = document.getElementById('hlRangeDateWrap');
        if (mode === 'single') {
            btnSingle.classList.add('bg-white','shadow','text-gray-900'); btnSingle.classList.remove('text-gray-400');
            btnRange.classList.remove('bg-white','shadow','text-gray-900'); btnRange.classList.add('text-gray-400');
            wrapSingle.classList.remove('hidden'); wrapRange.classList.add('hidden');
        } else {
            btnRange.classList.add('bg-white','shadow','text-gray-900'); btnRange.classList.remove('text-gray-400');
            btnSingle.classList.remove('bg-white','shadow','text-gray-900'); btnSingle.classList.add('text-gray-400');
            wrapSingle.classList.add('hidden'); wrapRange.classList.remove('hidden');
            updateHlPreview();
        }
    }

    function updateHlPreview() {
        const from = document.getElementById('hlDateFrom').value;
        const to   = document.getElementById('hlDateTo').value;
        const preview = document.getElementById('hlRangePreview');
        const text    = document.getElementById('hlRangePreviewText');
        if (!from || !to) { preview.classList.add('hidden'); return; }
        const d1 = new Date(from), d2 = new Date(to);
        if (d2 < d1) { preview.classList.add('hidden'); return; }
        const days = Math.round((d2 - d1) / 86400000) + 1;
        const fmt  = d => `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
        text.textContent = `Sẽ thêm ${days} ngày (${fmt(d1)} → ${fmt(d2)})`;
        preview.classList.remove('hidden');
    }

    function openHolidayModal(row) {
        const toggle = document.getElementById('hlModeToggle');
        if (row && row.id) {
            document.getElementById('hlModalTitle').textContent = t('admin.hl.modal.edit.title') || 'Chỉnh sửa ngày lễ';
            document.getElementById('hlEditId').value   = row.id;
            document.getElementById('hlDate').value     = row.holidayDate?.substring(0,10) || '';
            document.getElementById('hlName').value     = row.name || '';
            document.getElementById('hlRecurring').checked = row.isRecurring || false;
            document.getElementById('hlDate').readOnly  = true;
            document.getElementById('hlDate').classList.add('opacity-60');
            toggle.classList.add('hidden');
            setHlMode('single');
        } else {
            document.getElementById('hlModalTitle').textContent = t('admin.hl.modal.add.title') || 'Thêm ngày lễ';
            document.getElementById('hlEditId').value   = '';
            document.getElementById('hlDate').value     = new Date().toISOString().substring(0,10);
            document.getElementById('hlDateFrom').value = new Date().toISOString().substring(0,10);
            document.getElementById('hlDateTo').value   = '';
            document.getElementById('hlName').value     = '';
            document.getElementById('hlRecurring').checked = false;
            document.getElementById('hlDate').readOnly  = false;
            document.getElementById('hlDate').classList.remove('opacity-60');
            document.getElementById('hlRangePreview').classList.add('hidden');
            toggle.classList.remove('hidden');
            setHlMode('single');
        }
        const modal = document.getElementById('hlModal');
        modal.classList.remove('hidden');
        modal.style.display = 'flex';
    }

    function closeHolidayModal() {
        const modal = document.getElementById('hlModal');
        modal.classList.add('hidden');
        modal.style.display = 'none';
    }

    async function saveHoliday() {
        const id          = document.getElementById('hlEditId').value;
        const name        = document.getElementById('hlName').value.trim();
        const isRecurring = document.getElementById('hlRecurring').checked;
        if (!name) { alert(t('common.fill_all') || 'Vui lòng điền đầy đủ!'); return; }

        let url, body;
        if (id) {
            const holidayDate = document.getElementById('hlDate').value;
            if (!holidayDate) { alert(t('common.fill_all') || 'Vui lòng điền đầy đủ!'); return; }
            url  = '/Admin/SaveHoliday';
            body = { id: parseInt(id), holidayDate, name, isRecurring };
        } else if (hlMode === 'range') {
            const dateFrom = document.getElementById('hlDateFrom').value;
            const dateTo   = document.getElementById('hlDateTo').value;
            if (!dateFrom || !dateTo) { alert('Vui lòng chọn đủ ngày bắt đầu và kết thúc!'); return; }
            if (new Date(dateTo) < new Date(dateFrom)) { alert('Ngày kết thúc phải sau ngày bắt đầu!'); return; }
            url  = '/Admin/SaveHolidayRange';
            body = { dateFrom, dateTo, name, isRecurring };
        } else {
            const holidayDate = document.getElementById('hlDate').value;
            if (!holidayDate) { alert(t('common.fill_all') || 'Vui lòng điền đầy đủ!'); return; }
            url  = '/Admin/SaveHoliday';
            body = { id: null, holidayDate, name, isRecurring };
        }

        const res  = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const json = await res.json();
        if (json.success) {
            closeHolidayModal();
            loadHolidays(hlState.page || 1);
            if (json.created > 1) {
                const toast = document.createElement('div');
                toast.className = 'fixed top-4 right-4 z-[9999] bg-green-50 border-2 border-green-200 text-green-700 px-5 py-3 rounded-2xl shadow-xl font-semibold text-sm animate-fade-in';
                toast.textContent = `Đã thêm ${json.created} ngày lễ thành công!`;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }
        } else { alert(json.message || 'Có lỗi xảy ra!'); }
    }

    // ── Modal Delete ──────────────────────────────────────────────────────
    function openHolidayDeleteModal(id, name) {
        hlState.deleteId = id;
        document.getElementById('hlDeleteMsg').textContent = `${t('admin.hl.confirm.del') || 'Bạn có chắc muốn xóa ngày lễ'} "${name}"?`;
        const modal = document.getElementById('hlDeleteModal');
        modal.classList.remove('hidden');
        modal.style.display = 'flex';
    }

    function closeHolidayDeleteModal() {
        const modal = document.getElementById('hlDeleteModal');
        modal.classList.add('hidden');
        modal.style.display = 'none';
        hlState.deleteId = null;
    }

    async function confirmDeleteHoliday() {
        if (!hlState.deleteId) return;
        const res  = await fetch('/Admin/DeleteHoliday', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(hlState.deleteId)
        });
        const json = await res.json();
        if (json.success) { closeHolidayDeleteModal(); loadHolidays(hlState.page || 1); }
        else alert(json.message || 'Có lỗi xảy ra!');
    }

    function resetHolidayFilter() {
        document.getElementById('hlFilterKeyword').value = '';
        // Giữ năm hiện tại
        document.getElementById('hlFilterYear').value = new Date().getFullYear();
        loadHolidays(1);
    }

    // ── Close holiday modals on outside click ─────────────────────────────
    document.getElementById('hlModal')?.addEventListener('click',       e => { if (e.target === e.currentTarget) closeHolidayModal(); });
    document.getElementById('hlDeleteModal')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeHolidayDeleteModal(); });

</script>
