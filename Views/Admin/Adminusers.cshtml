@model List<HeatmapSystem.Models.SVN_User>
@{
    Layout = "_Layout";
    ViewData["Title"] = "用户管理 / User Management ";
    ViewData["PageName"] = "AdminUsers";
}

<style>
    /* Override Tailwind với specificity cao */
    #adminPage .page-header {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: wrap !important;
    }

    #adminPage .stats-container {
        display: flex !important;
        gap: 0.75rem !important;
    }

    #adminPage .tab-navigation {
        display: flex !important;
        gap: 0.5rem !important;
    }

    /* MOBILE RESPONSIVE - CRITICAL */
    @@media (max-width: 639px) {
        #adminPage .page-header {
            flex-direction: column !important;
            align-items: flex-start !important;
        }

        #adminPage .page-header > div:first-child {
            width: 100% !important;
            margin-bottom: 1rem !important;
        }

        #adminPage .stats-container {
            width: 100% !important;
            flex-direction: column !important;
        }

        #adminPage .stats-card {
            width: 100% !important;
        }

        #adminPage .tab-navigation {
            width: 100% !important;
            flex-direction: column !important;
        }

        #adminPage .tab-button {
            width: 100% !important;
        }

        #adminPage .page-title {
            font-size: 2rem !important;
        }

        #adminPage .hide-on-mobile {
            display: none !important;
        }

        #adminPage .desktop-only {
            display: none !important;
        }

        /* MOBILE: Hide table, show cards */
        #adminPage .users-table {
            display: none !important;
        }

        #adminPage .users-cards {
            display: block !important;
        }

        #adminPage .modal-content {
            width: 95% !important;
            margin: 0.5rem !important;
        }

        #adminPage .modal-buttons {
            flex-direction: column !important;
        }

        #adminPage .modal-buttons button {
            width: 100% !important;
        }

        #adminPage .pagination-container {
            flex-direction: column !important;
            text-align: center !important;
        }

        #adminPage .log-entry-content {
            flex-direction: column !important;
        }

        #adminPage .filter-grid {
            grid-template-columns: 1fr !important;
        }

        #adminPage .filter-actions {
            flex-direction: column !important;
        }

        #adminPage .filter-actions > * {
            width: 100% !important;
        }
    }

    /* DESKTOP: Hide cards, show table */
    @@media (min-width: 640px) {
        #adminPage .users-table {
            display: block !important;
        }

        #adminPage .users-cards {
            display: none !important;
        }
    }

    /* Tab styling */
    .tab-button {
        position: relative;
        opacity: 0.6;
        transition: all 0.3s ease;
    }

    .tab-button.active {
        opacity: 1;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;
        color: white !important;
    }

    .tab-button:not(.active):hover {
        opacity: 0.8;
    }

    .tab-content {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-in-out;
    }

    /* Table responsive */
    @@media (max-width: 1024px) {
        #adminPage .table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }

        #adminPage table {
            min-width: 900px !important;
        }
    }

    /* Desktop hover */
    @@media (min-width: 1024px) {
        #adminPage table tbody tr:hover {
            background-color: rgba(249, 250, 251, 1) !important;
        }
    }
</style>

<div id="adminPage" class="min-h-screen bg-gradient-to-br from-gray-50 to-red-50/30 py-6 md:py-12 px-4">

   <!-- Header -->
    <div class="max-w-7xl mx-auto mb-8 md:mb-12">
        <div class="page-header">
            <div>
                <h1 class="page-title text-3xl md:text-4xl lg:text-5xl font-black mb-2 text-gray-900">
                    <span data-i18n="admin.title">Quản lý hệ thống</span>
                </h1>
                <p class="text-base md:text-lg text-gray-500 font-medium" data-i18n="admin.subtitle">Người dùng và lịch sử hoạt động</p>
            </div>
            <div class="stats-container">
                <div class="stats-card bg-white px-4 md:px-6 py-3 rounded-2xl shadow-lg">
                    <p class="text-sm text-gray-500" data-i18n="admin.stat.accounts">Tổng tài khoản</p>
                    <p class="text-2xl md:text-3xl font-black text-red-600">@Model.Count</p>
                </div>
                <div class="stats-card bg-white px-4 md:px-6 py-3 rounded-2xl shadow-lg">
                    <p class="text-sm text-gray-500" data-i18n="admin.stat.logs">Tổng logs</p>
                    <p class="text-2xl md:text-3xl font-black text-blue-600">@ViewBag.TotalLogs</p>
                </div>
            </div>
        </div>
    </div>


    <div class="max-w-7xl mx-auto">

        @if (TempData["Success"] != null)
        {
            <div class="mb-6 p-4 md:p-6 bg-green-50 border-2 border-green-200 rounded-2xl md:rounded-3xl animate-fade-in">
                <div class="flex items-start md:items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 text-green-600 mr-2 md:mr-3 flex-shrink-0" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-sm md:text-base text-green-700 font-semibold break-words">@TempData["Success"]</p>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 md:p-6 bg-red-50 border-2 border-red-200 rounded-2xl md:rounded-3xl animate-fade-in">
                <div class="flex items-start md:items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 text-red-600 mr-2 md:mr-3 flex-shrink-0" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-sm md:text-base text-red-600 font-semibold break-words">@TempData["Error"]</p>
                </div>
            </div>
        }

        <!-- Tab Navigation -->
        <div class="tab-navigation mb-6 md:mb-8">
            <button onclick="switchTab('users')" id="usersTab"
                    class="tab-button active px-6 md:px-8 py-3 md:py-4 bg-white rounded-xl md:rounded-2xl font-bold shadow-lg transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <span class="hidden sm:inline" data-i18n="admin.tab.users">Danh sách Users</span>
                <span class="sm:hidden" data-i18n="admin.tab.users.short">Users</span>
            </button>
            <button onclick="switchTab('logs')" id="logsTab"
                    class="tab-button px-6 md:px-8 py-3 md:py-4 bg-white rounded-xl md:rounded-2xl font-bold shadow-lg transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="hidden sm:inline" data-i18n="admin.tab.logs">Lịch sử Log</span>
                <span class="sm:hidden" data-i18n="admin.tab.logs.short">Logs</span>
            </button>
            <button onclick="switchTab('workconfig')" id="workconfigTab"
                    class="tab-button px-6 md:px-8 py-3 md:py-4 bg-white rounded-xl md:rounded-2xl font-bold shadow-lg transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="hidden sm:inline" data-i18n="admin.wc.tab">Cấu hình giờ làm</span>
                <span class="sm:hidden" data-i18n="admin.wc.tab.short">Giờ làm</span>
            </button>
            <button onclick="switchTab('holiday')" id="holidayTab"
                    class="tab-button px-6 md:px-8 py-3 md:py-4 bg-white rounded-xl md:rounded-2xl font-bold shadow-lg transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="hidden sm:inline" data-i18n="admin.hl.tab">Ngày Nghỉ Lễ</span>
                <span class="sm:hidden" data-i18n="admin.hl.tab.short">Lễ</span>
            </button>
            <a href="/Heatmap/Home"
               class="tab-button px-6 md:px-8 py-3 md:py-4 bg-white rounded-xl md:rounded-2xl font-bold shadow-lg transition-all flex items-center justify-center gap-2"
               style="text-decoration: none; color: inherit;">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="hidden sm:inline" data-i18n="admin.tab.home">Home Heatmap</span>
                <span class="sm:hidden" data-i18n="admin.tab.home.short">Home</span>
            </a>
        </div>

        <!-- Users Tab Content -->
        <div id="usersContent" class="tab-content">

            <!-- DESKTOP: Table View -->
            <div class="users-table bg-white rounded-2xl md:rounded-[2.5rem] shadow-[0_20px_60px_rgba(0,0,0,0.08)] border border-gray-100 overflow-hidden">
                <div class="table-container overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-100">
                            <tr>
                                <th class="px-3 md:px-6 py-3 md:py-4 text-left text-xs font-black uppercase tracking-widest text-gray-500">
                                    <span data-i18n="admin.col.svn">Mã SVN</span>
                                </th>
                                <th class="px-3 md:px-6 py-3 md:py-4 text-left text-xs font-black uppercase tracking-widest text-gray-500">
                                    <span data-i18n="admin.col.role">Quyền</span>
                                </th>
                                <th class="px-3 md:px-6 py-3 md:py-4 text-left text-xs font-black uppercase tracking-widest text-gray-500 hide-on-mobile">
                                    <span data-i18n="admin.col.created">Ngày tạo</span>
                                </th>
                                <th class="px-3 md:px-6 py-3 md:py-4 text-left text-xs font-black uppercase tracking-widest text-gray-500 hide-on-mobile">
                                    <span data-i18n="admin.col.last_login">Đăng nhập cuối</span>
                                </th>
                                <th class="px-3 md:px-6 py-3 md:py-4 text-left text-xs font-black uppercase tracking-widest text-gray-500 desktop-only">
                                    <span data-i18n="admin.col.password">Mật khẩu</span>
                                </th>
                                <th class="px-3 md:px-6 py-3 md:py-4 text-center text-xs font-black uppercase tracking-widest text-gray-500">
                                    <span data-i18n="admin.col.action">Thao tác</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var user in Model)
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-3 md:px-6 py-3 md:py-4">
                                        <div>
                                            <p class="text-sm md:text-base font-bold text-gray-900 break-all">@user.SVNCode</p>
                                            @if (user.IsAdmin)
                                            {
                                                <span class="admin-badge inline-flex items-center px-2 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800 mt-1">
                                                    👑 Admin
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-3 md:px-6 py-3 md:py-4">
                                        @if (user.IsAdmin)
                                        {
                                            <span class="permission-badge inline-flex items-center px-2 md:px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800"
                                                data-i18n="admin.perm.full">Full Access</span>
                                        }
                                        else if (user.Permission == "Update")
                                        {
                                            <span class="permission-badge inline-flex items-center px-2 md:px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800"
                                                data-i18n="admin.perm.update">✏️ Update</span>
                                        }
                                        else if (user.Permission == "Read")
                                        {
                                            <span class="permission-badge inline-flex items-center px-2 md:px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800"
                                                data-i18n="admin.perm.read">👁️ Read</span>
                                        }
                                        else
                                        {
                                            <span class="permission-badge inline-flex items-center px-2 md:px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-800"
                                                data-i18n="admin.perm.none">🚫 No Access</span>
                                        }
                                    </td>
                                    <td class="px-3 md:px-6 py-3 md:py-4 hide-on-mobile">
                                        <p class="text-xs md:text-sm text-gray-600">
                                            @(user.CreateDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                        </p>
                                    </td>
                                    <td class="px-3 md:px-6 py-3 md:py-4 hide-on-mobile">
                                        <p class="text-xs md:text-sm text-gray-600"
                                        data-lastlogin="@(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "")">
                                            @(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")
                                        </p>
                                    </td>
                                    <td class="px-3 md:px-6 py-3 md:py-4 desktop-only">
                                        <code class="text-xs bg-gray-100 px-2 py-1 rounded">
                                            @(user.Password?.Length > 20 ? user.Password.Substring(0, 20) + "..." : user.Password)
                                        </code>
                                    </td>
                                    <td class="px-3 md:px-6 py-3 md:py-4">
                                        <div class="action-buttons flex flex-col md:flex-row gap-2 justify-center">
                                            @if (!user.IsAdmin)
                                            {
                                                <button onclick="openResetModal('@user.SVNCode')"
                                                        class="px-3 md:px-4 py-2 bg-blue-50 text-blue-600 rounded-xl hover:bg-blue-100 transition-all text-xs md:text-sm font-bold whitespace-nowrap"
                                                        data-i18n="admin.btn.reset_pw">
                                                    🔑 Reset PW
                                                </button>
                                                <button onclick="openPermissionModal('@user.SVNCode', '@user.Permission')"
                                                        class="px-3 md:px-4 py-2 bg-green-50 text-green-600 rounded-xl hover:bg-green-100 transition-all text-xs md:text-sm font-bold whitespace-nowrap"
                                                        data-i18n="admin.btn.permission">
                                                    🔐 Phân quyền
                                                </button>
                                                <form method="post" action="/Admin/DeleteUser" style="display:inline;"
                                                    onsubmit="return confirm('⚠️ ' + t('admin.confirm.delete') + ' [@user.SVNCode]?')">
                                                    <input type="hidden" name="SVNCode" value="@user.SVNCode" />
                                                    <button type="submit"
                                                            class="px-3 md:px-4 py-2 bg-red-50 text-red-600 rounded-xl hover:bg-red-100 transition-all text-xs md:text-sm font-bold whitespace-nowrap w-full md:w-auto"
                                                            data-i18n="admin.btn.delete">
                                                        🗑️ Xóa
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-xs md:text-sm text-gray-400 italic"
                                                    data-i18n="admin.perm.no_edit">Không thể chỉnh sửa Admin</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MOBILE: Card View -->
            <div class="users-cards space-y-4">
                @foreach (var user in Model)
                {
                    <div class="bg-white rounded-2xl shadow-lg p-4 border border-gray-100">
                        <!-- User Header -->
                        <div class="mb-3 pb-3 border-b border-gray-100">
                            <div class="flex items-start justify-between mb-2">
                                <div>
                                    <p class="text-base font-black text-gray-900 break-all mb-1">@user.SVNCode</p>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800">
                                            👑 Admin
                                        </span>
                                    }
                                </div>
                                <div>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800"
                                            data-i18n="admin.perm.full">Full Access</span>
                                    }
                                    else if (user.Permission == "Update")
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800"
                                            data-i18n="admin.perm.update">✏️ Update</span>
                                    }
                                    else if (user.Permission == "Read")
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800"
                                            data-i18n="admin.perm.read">👁️ Read</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-800"
                                            data-i18n="admin.perm.none">🚫 No Access</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        @if (!user.IsAdmin)
                        {
                            <div class="space-y-2">
                                <button onclick="openResetModal('@user.SVNCode')"
                                        class="w-full px-4 py-3 bg-blue-50 text-blue-600 rounded-xl hover:bg-blue-100 transition-all text-sm font-bold"
                                        data-i18n="admin.btn.reset_pw_long">
                                    🔑 Reset mật khẩu
                                </button>
                                <button onclick="openPermissionModal('@user.SVNCode', '@user.Permission')"
                                        class="w-full px-4 py-3 bg-green-50 text-green-600 rounded-xl hover:bg-green-100 transition-all text-sm font-bold"
                                        data-i18n="admin.btn.permission">
                                    🔐 Phân quyền
                                </button>
                                <form method="post" action="/Admin/DeleteUser"
                                    onsubmit="return confirm('⚠️ ' + t('admin.confirm.delete') + ' [@user.SVNCode]?')">
                                    <input type="hidden" name="SVNCode" value="@user.SVNCode" />
                                    <button type="submit"
                                            class="w-full px-4 py-3 bg-red-50 text-red-600 rounded-xl hover:bg-red-100 transition-all text-sm font-bold"
                                            data-i18n="admin.btn.delete_long">
                                        🗑️ Xóa tài khoản
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-gray-400 italic text-center py-2"
                            data-i18n="admin.perm.no_edit">Không thể chỉnh sửa Admin</p>
                        }
                    </div>
                }
            </div>

        </div>

        <!-- Logs Tab Content -->
        <div id="logsContent" class="tab-content hidden">
            <!-- Filter Section -->
            <div class="filter-section bg-white rounded-2xl md:rounded-3xl shadow-xl p-4 md:p-6 mb-6">
                <h3 class="text-lg md:text-xl font-black mb-4 text-gray-900"
                    data-i18n="admin.log.filter.title">🔍 Bộ lọc</h3>
                <form method="get" action="/Admin/Users">
                    <div class="filter-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-2"
                                data-i18n="admin.log.filter.svn">Mã SVN</label>
                            <input type="text" name="svnCodeFilter" value="@ViewBag.SvnCodeFilter"
                                data-i18n-placeholder="admin.log.filter.svn.ph"
                                placeholder="Nhập mã SVN..."
                                class="w-full px-4 py-2 md:py-3 bg-gray-50 border-2 border-transparent rounded-xl focus:bg-white focus:border-blue-600 focus:ring-0 outline-none transition-all text-sm md:text-base" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-2"
                                data-i18n="admin.log.filter.action">Loại hành động</label>
                            <select name="actionTypeFilter"
                                    class="w-full px-4 py-2 md:py-3 bg-gray-50 border-2 border-transparent rounded-xl focus:bg-white focus:border-blue-600 focus:ring-0 outline-none transition-all text-sm md:text-base">
                                <option value="" data-i18n="admin.log.filter.all">-- Tất cả --</option>
                                @foreach (var actionType in ViewBag.ActionTypes)
                                {
                                    @if (ViewBag.ActionTypeFilter == actionType)
                                    {
                                        <option value="@actionType" selected>@actionType</option>
                                    }
                                    else
                                    {
                                        <option value="@actionType">@actionType</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-2"
                                data-i18n="admin.log.filter.from">Từ ngày</label>
                            <input type="date" name="fromDate" value="@ViewBag.FromDate"
                                class="w-full px-4 py-2 md:py-3 bg-gray-50 border-2 border-transparent rounded-xl focus:bg-white focus:border-blue-600 focus:ring-0 outline-none transition-all text-sm md:text-base" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-2"
