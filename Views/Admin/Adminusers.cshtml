                    @foreach (var log in ViewBag.Logs)
                    {
                        <div class="log-entry p-3 md:p-4 bg-gray-50 rounded-xl md:rounded-2xl hover:bg-gray-100 transition-all border border-gray-200">
                            <div class="log-entry-content flex flex-col md:flex-row md:items-center md:justify-between gap-2 md:gap-4">
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-center gap-2 mb-2">
