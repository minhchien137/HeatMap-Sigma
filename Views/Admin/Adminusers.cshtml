                                   data-i18n="admin.log.page.prev">
                                    ← Trước
                                </a>
                            }
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <a href="?page=@(ViewBag.CurrentPage + 1)&svnCodeFilter=@ViewBag.SvnCodeFilter&actionTypeFilter=@ViewBag.ActionTypeFilter&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate"
                                   class="pagination-button px-4 py-2 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition-all shadow-lg"
                                   data-i18n="admin.log.page.next">
